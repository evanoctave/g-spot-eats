{
  "expo": {
    "name": "GSpot Eats",
    "slug": "gspot-eats",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "gspoteats",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.gspoteats.mobile",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.gspoteats.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
